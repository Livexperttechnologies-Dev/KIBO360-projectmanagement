# ==============================================================================
# KIBO360 Project Hub — Staging Environment Template (.env.staging)
# Livexpert Technologies Pvt. Ltd.
# Used for pre-release validation and QA verification before production deploy.
# ==============================================================================

# Application Environment
NODE_ENV=production

# Staging Server Port (Dedicated port 5001)
PORT=5001

# Staging URLs & CORS Allowed Origins (Dedicated port 5174)
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174
SUPER_ADMIN_EMAIL=admin@livexpert.in
INITIAL_ADMIN_NAME=KIBO360 Staging Super Admin
# Use a unique password with at least 12 characters; replace before staging deployment.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# Generate a separate 32-byte key with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=CHANGE_ME_REPLACE_WITH_A_UNIQUE_64_CHAR_HEX_KEY

# Staging PostgreSQL Database (Dedicated port 5433)
STAGING_POSTGRES_PASSWORD=CHANGE_ME_STAGING_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_STAGING_DATABASE_PASSWORD@localhost:5433/kibo360_staging?schema=public

# Staging JWT Secrets
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Company Timezone (Asia/Kolkata UTC+05:30)
COMPANY_TIMEZONE=Asia/Kolkata

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
