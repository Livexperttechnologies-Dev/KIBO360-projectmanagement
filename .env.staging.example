# ==============================================================================
# KIBO360 Project Hub — Staging Environment Template (.env.staging)
# Livexpert Technologies Pvt. Ltd.
# Used for pre-release validation and QA verification before production deploy.
# ==============================================================================

# Application Environment
NODE_ENV=production

# Staging Server Port (Dedicated port 5001)
PORT=5001

# Staging URLs & CORS Allowed Origins (Dedicated port 5174)
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Staging PostgreSQL Database (Dedicated port 5433)
DATABASE_URL=postgresql://postgres:StagingPostgres2026Secure!@localhost:5433/kibo360_staging?schema=public

# Staging JWT Secrets
JWT_ACCESS_SECRET=a7c8e9d01234567890abcdef1234567890abcdef1234567890abcdef12345678
JWT_REFRESH_SECRET=b8d9e0f1234567890abcdef1234567890abcdef1234567890abcdef12345678
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Company Timezone (Asia/Kolkata UTC+05:30)
COMPANY_TIMEZONE=Asia/Kolkata

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000

# Outbound SMTP Configuration (Console simulation in staging)
SMTP_HOST=smtp.livexpert.in
SMTP_PORT=587
SMTP_USER=staging-notifications@livexpert.in
SMTP_PASS=StagingSmtpPassword2026!
SMTP_FROM=Livexpert Staging QA <staging-qa@livexpert.in>
