{
  "name": "kibo360-hub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for KIBO360 Project Hub",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsc && node dist/src/index.js",
    "dev:watch": "tsc && node --watch dist/src/index.js",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/tests/*.js",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.7",
    "@types/selfsigned": "^2.0.4",
    "prisma": "^6.3.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5.7.3"
  }
}
