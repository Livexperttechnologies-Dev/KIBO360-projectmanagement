PORT=5002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Replace CHANGE_ME with the password configured for your local PostgreSQL user.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/kibo360_hub?schema=public
# Browser URL used for CORS and application links.
# Change the port if Vite starts on a different port (for example, 5174).
FRONTEND_URL=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@livexpert.in
# Optional for local use; production must set a unique 64-character hexadecimal key.
TOTP_ENCRYPTION_KEY=
# Usually 587 (STARTTLS); use 465 for providers requiring implicit TLS.
