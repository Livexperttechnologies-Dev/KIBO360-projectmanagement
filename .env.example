# ==============================================================================
# KIBO360 Project Hub — Environment Configuration Template
# Livexpert Technologies Pvt. Ltd.
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Frontend Client URL & CORS Whitelist
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kibo360_hub?schema=public

# JWT Security Secrets (Must be set to strong 32+ character secrets in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Company Timezone (IANA Timezone String)
COMPANY_TIMEZONE=Asia/Kolkata

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Outbound SMTP Mail Dispatch (Optional in development, console fallback active)
SMTP_HOST=smtp.livexpert.in
SMTP_PORT=587
SMTP_USER=no-reply@livexpert.in
SMTP_PASS=your_smtp_app_password
SMTP_FROM=Livexpert Security <security@livexpert.in>
