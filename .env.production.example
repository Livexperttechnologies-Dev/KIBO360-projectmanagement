# ==============================================================================
# KIBO360 Project Hub — Production Environment Template (.env.production)
# Livexpert Technologies Pvt. Ltd.
# Copy to .env.production and provide real credentials before deployment.
# ==============================================================================

# Application Environment
NODE_ENV=production

# Server Port
PORT=5000

# Production URLs & CORS Allowed Origins
FRONTEND_URL=https://kibo360.livexpert.in
CORS_ORIGIN=https://kibo360.livexpert.in
SUPER_ADMIN_EMAIL=admin@livexpert.in
# Initial account is created only when this email does not exist in the database.
# Use a unique password with at least 12 characters. It is not rotated on redeploy.
INITIAL_ADMIN_NAME=KIBO360 Super Admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
# Generate a separate 32-byte key with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=CHANGE_ME_REPLACE_WITH_A_UNIQUE_64_CHAR_HEX_KEY

# Production PostgreSQL Database
# Connects with unprivileged application user created by init-prod-db.sql
POSTGRES_DB=kibo360_hub
POSTGRES_USER=postgres
# Generate both as hex with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_UNIQUE_HEX_SECRET
POSTGRES_APP_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_HEX_SECRET

# Cryptographic JWT Secrets (Must be 32+ random characters; generate with 'openssl rand -hex 32')
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_UNIQUE_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Company Timezone (Asia/Kolkata UTC+05:30)
COMPANY_TIMEZONE=Asia/Kolkata

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Reverse proxies in front of the API (Dokploy Traefik = 1). Used for client IPs and rate limits.
TRUST_PROXY=1
