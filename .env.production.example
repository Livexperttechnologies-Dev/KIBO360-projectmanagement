# ==============================================================================
# KIBO360 Project Hub — Production Environment Template (.env.production)
# Livexpert Technologies Pvt. Ltd.
# Copy to .env.production and provide real credentials before deployment.
# ==============================================================================

# Application Environment
NODE_ENV=production

# Server Port
PORT=5000

# Production URLs & CORS Allowed Origins
FRONTEND_URL=https://kibo360.livexpert.in
CORS_ORIGIN=https://kibo360.livexpert.in

# Production PostgreSQL Database
# Connects with unprivileged application user created by init-prod-db.sql
DATABASE_URL=postgresql://kibo360_app:LivexpertProd2026SecureApp!@localhost:5432/kibo360_hub?schema=public&sslmode=prefer

# Cryptographic JWT Secrets (Must be 32+ random characters; generate with 'openssl rand -hex 32')
JWT_ACCESS_SECRET=c8e762c4a9f94eb9a19c5c93c17804472314567890abcdef1234567890abcdef
JWT_REFRESH_SECRET=f9d45e67890abcdef1234567890abcdef2314567890abcdef1234567890abcdef
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Company Timezone (Asia/Kolkata UTC+05:30)
COMPANY_TIMEZONE=Asia/Kolkata

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Production SMTP Mail Dispatch
SMTP_HOST=smtp.livexpert.in
SMTP_PORT=587
SMTP_USER=no-reply@livexpert.in
SMTP_PASS=SuperSecureProdSmtpPassword2026!
SMTP_FROM=Livexpert Security <security@livexpert.in>
